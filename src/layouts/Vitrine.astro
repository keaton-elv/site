---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import Layout from "./Layout.astro";
import Loop from "../components/Loop.astro";

interface Props {
    entry: CollectionEntry<"artifacts">;
    prev?: string;
    next?: string;
}

const { entry, prev, next } = Astro.props;
const a = entry.data;

const CAP = 1.5;
const PAD = 2;
const PADM = 1; // the phone cedes side pad to the artifact
const GAP = 1;
const ROWGAP = 1;
const RECORD = 11;
const STRIP = 8;

const native = a.image;

// rem of chrome reserved around the media box, [horizontal, vertical],
// in each arrangement of the record
const stage = {
    wide: [2 * PAD + 2 * GAP + 2 * RECORD, 2 * PAD],
    tall: [2 * PADM, 2 * PAD + ROWGAP + STRIP],
};
const box = ([w, h]: number[]) =>
    `min(${Math.round(native.width / CAP)}px, calc(100vw - ${w}rem), calc((100vh - ${h}rem) * ${(native.width / native.height).toFixed(4)}))`;
const sizes = `(min-width: 45rem) ${box(stage.wide)}, ${box(stage.tall)}`;

const vars = [
    `--nw: ${native.width}px`,
    `--nh: ${native.height}px`,
    `--cap: ${CAP}`,
    `--pad: ${PAD}rem`,
    `--padm: ${PADM}rem`,
    `--gap: ${GAP}rem`,
    `--rowgap: ${ROWGAP}rem`,
    `--record: ${RECORD}rem`,
    `--strip: ${STRIP}rem`,
].join("; ");

const meta = [a.device, a.year].filter(Boolean).join(", ");
---

<Layout title={a.title} prev={prev} next={next}>
    <main class="vitrine" style={vars}>
        <figure>
            {
                a.video ? (
                    <Loop src={a.video} still={native} />
                ) : (
                    <Image
                        src={a.image}
                        alt={a.alt ?? ""}
                        sizes={sizes}
                        format="avif"
                        loading="eager"
                        fetchpriority="high"
                    />
                )
            }
            <figcaption class="record">
                <h1>{a.title}</h1>
                <p class="meta">{meta}</p>
            </figcaption>
        </figure>
    </main>
</Layout>

<style>
    .vitrine {
        display: grid;
        grid-template-rows: minmax(0, 1fr);
        height: 100svh;
        padding: var(--pad) var(--padm);
        overflow: clip;
    }

    figure {
        display: grid;
        grid-template-rows: minmax(0, 1fr) var(--strip);
        row-gap: var(--rowgap);
        place-items: center;
        margin: 0;
    }
    .record {
        justify-self: start;
        align-self: start;
        max-width: 100%;
    }
    @media (min-width: 45rem) {
        .vitrine {
            padding: var(--pad);
        }
        figure {
            grid-template-rows: minmax(0, 1fr);
            grid-template-columns: var(--record) minmax(0, 1fr) var(--record);
            column-gap: var(--gap);
        }
        figure > :is(img, video) {
            grid-area: 1 / 2;
        }
        .record {
            grid-area: 1 / 3;
            align-self: center;
        }
    }
    .record h1 {
        margin: 0;
        font: 400 0.8125rem/1.5 var(--font-mono);
        color: var(--ink);
    }
    .record .meta {
        margin: 0.1rem 0 0;
        color: var(--dim);
    }

    .vitrine img {
        max-width: min(calc(var(--nw) / var(--cap)), 100%);
        max-height: min(calc(var(--nh) / var(--cap)), 100%);
        width: auto;
        height: auto;
    }

    .vitrine video {
        width: min(calc(var(--nw) / var(--cap)), 100%);
        max-height: min(calc(var(--nh) / var(--cap)), 100%);
    }
</style>
