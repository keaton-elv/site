---
import type { CollectionEntry } from "astro:content";
import Layout from "./Layout.astro";

interface Props {
    entry: CollectionEntry<"artifacts">;
    prev?: string;
    next?: string;
}

const { entry, prev, next } = Astro.props;
const { title, dek, draft } = entry.data;

// Alternate verso (text left, asides right) and recto (the mirror).
// Each h2 also gets a § anchor. Figure images render at column width,
// so their `sizes` are corrected here (keep in step with --measure).
const html = (await Astro.slots.render("default"))
    .replaceAll(
        /sizes="[^"]*"/g,
        'sizes="(max-width: 45rem) 100vw, (max-width: 76rem) calc(100vw - 2.5rem), 48rem"',
    )
    .replaceAll(/<div class="(wide|full)">[\s\S]*?<\/div>/g, (breakout, kind) =>
        breakout.replaceAll(
            /sizes="[^"]*"/g,
            kind === "full"
                ? 'sizes="100vw"'
                : 'sizes="(max-width: 45rem) 100vw, (max-width: 76rem) calc(100vw - 2.5rem), 66.5rem"',
        ),
    );
const [lede, ...sections] = html.split(/(?=<h2 )/);
const spreads = sections.map((section) => {
    const id = section.match(/^<h2 id="([^"]+)"/)?.[1];
    return id
        ? section.replace(
              "</h2>",
              `<a class="sec" href="#${id}" aria-label="link to this section">&thinsp;§</a></h2>`,
          )
        : section;
});
---

<Layout
    title={title}
    description={dek}
    prev={prev}
    next={next}
    serif
    sans={html.includes("<aside") ? [600] : []}
>
    <main class="essay">
        <header class:list={["spread", draft && "draft"]}>
            <h1>{title}</h1>
            {draft && <p class="unfiled">(unfiled)</p>}
        </header>
        {lede.trim() && <section class="spread" set:html={lede} />}
        {
            spreads.map((spread, i) => (
                <section
                    class={`spread${i % 2 ? " recto" : ""}`}
                    set:html={spread}
                />
            ))
        }
    </main>
</Layout>

<style is:global>
    /* a draft answers its index entry: unfiled rides beside the title */
    .essay header.draft {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        column-gap: 1.5rem;
    }
    .essay .unfiled {
        margin: 0;
        font: 400 1.5rem/1.5 var(--font-mono);
        color: var(--dim);
    }

    .essay {
        --measure: 48rem;
        --aside-w: 15rem;
        --aside-gap: 3.5rem;
        --pad-left: 8rem;
        padding: 4rem 2rem 30svh var(--pad-left);
        font-family: var(--font-serif);
        font-size: 1.625rem;
        line-height: 1.5;
        font-variant-ligatures: normal;
        overflow-x: clip;
    }

    /* the spread: verso by default, recto pushes the column right */
    .essay .spread {
        width: min(var(--measure), 100%);
        margin-top: 4.5rem;
    }
    .essay .spread.recto {
        margin-left: calc(var(--aside-w) + var(--aside-gap));
    }
    .essay header.spread {
        margin-top: 0;
    }
    /* no section break under the title; the lede's own margin sets the gap */
    .essay header.spread + .spread {
        margin-top: 0;
    }

    .essay h1 {
        margin: 0;
        font-size: clamp(3.25rem, 13vw, 6rem);
        font-style: italic;
        font-weight: 400;
        line-height: 1.1;
    }
    .essay h1 {
        text-transform: capitalize;
    }
    .essay h2 {
        margin: 0 0 1.75rem;
        font-size: 3rem;
        font-style: italic;
        font-weight: 400;
        line-height: 1.25;
        text-wrap: balance;
        scroll-margin-top: 4rem;
    }
    .essay .sec {
        opacity: 0;
        color: var(--dim);
        font-family: var(--font-mono);
        font-style: normal;
        font-size: 0.75em;
        text-decoration: none;
        transition:
            opacity 240ms ease,
            color 120ms ease;
    }
    .essay h2:hover .sec,
    .essay .sec:focus-visible {
        opacity: 1;
    }
    .essay .sec:hover {
        color: var(--ink);
    }

    .essay .spread > p,
    .essay blockquote > p {
        text-align: justify;
        hyphens: auto;
        hyphenate-limit-chars: 6 3 3;
    }

    /* asides hang in the margin, top-aligned with the paragraph they
       follow; on the phone they stay in flow, below it */
    .essay .annotated {
        position: relative;
    }
    .essay .asides {
        position: absolute;
        top: 0;
        left: calc(100% + var(--aside-gap));
        width: var(--aside-w);
    }
    .essay .recto .asides {
        left: auto;
        right: calc(100% + var(--aside-gap));
    }
    .essay aside {
        font: 400 0.8125rem/1.55 var(--font-mono);
    }
    .essay aside + aside {
        margin-top: 1.25rem;
    }
    .essay aside .anchor {
        font-family: var(--font-sans);
        font-weight: 600;
    }
    .essay aside p {
        margin: 0.5rem 0 0;
        color: var(--dim);
    }

    .essay figure {
        margin: 2.25rem 0;
    }
    .essay figcaption {
        margin-top: 0.6rem;
        font: 400 0.8125rem/1.5 var(--font-mono);
        color: var(--dim);
        text-align: right;
    }
    .essay figure img {
        width: 100%;
        height: auto;
    }

    /* breakouts: .wide spans into the aside margin, .full takes the window */
    .essay .spread > .wide {
        width: calc(var(--measure) + var(--aside-gap) + var(--aside-w));
    }
    .essay .spread.recto > .wide {
        margin-left: calc(-1 * (var(--aside-gap) + var(--aside-w)));
    }
    .essay .spread > .full {
        width: 100vw;
        margin-left: calc(-1 * var(--pad-left));
    }

    .essay blockquote {
        margin: 2.25rem 0;
        padding-left: 1.5rem;
        border-left: 1px solid var(--line);
        font-style: italic;
    }

    .essay sup {
        font-family: var(--font-mono);
        font-size: 0.65em;
        line-height: 0;
    }

    .essay .sc {
        font-variant-caps: all-small-caps;
        letter-spacing: 0.03em;
    }
    .essay p.versal::first-letter {
        font-variant-caps: normal;
        text-transform: uppercase;
    }

    /* each section settles its own accounts */
    .essay footer.notes {
        margin-top: 3rem;
        padding-top: 0.85rem;
        border-top: 1px solid var(--line);
        font: 400 0.8125rem/1.6 var(--font-mono);
        color: var(--dim);
    }
    .essay footer.notes p {
        margin: 0 0 0.35rem;
    }

    /* below every font: shorthand — the shorthand resets ligatures on */
    .essay :is(figcaption, aside, footer.notes, sup, .unfiled) {
        font-variant-ligatures: none;
    }

    @media (max-width: 76rem) {
        .essay {
            --pad-left: 1.25rem;
            padding: 3.5rem 1.25rem 30svh var(--pad-left);
        }
        .essay .spread.recto {
            margin-left: 0;
        }
        .essay .spread > .wide,
        .essay .spread.recto > .wide {
            width: auto;
            margin-left: 0;
        }
        .essay .asides {
            position: static; /* left/right no longer apply, recto included */
            width: auto;
        }
        .essay aside {
            margin: 1.75rem 0;
            padding-left: 1.25rem;
            border-left: 1px solid var(--ink);
        }
    }

    @media (max-width: 45rem) {
        .essay {
            font-size: 1.25rem;
            line-height: 1.45;
        }
        .essay .spread > p,
        .essay blockquote > p {
            text-align: left;
        }
        .essay .spread > figure,
        .essay .spread > .wide,
        .essay .spread.recto > .wide {
            margin-inline: calc(-1 * var(--pad-left));
        }
        .essay figcaption {
            padding-inline: var(--pad-left);
        }
    }
</style>
