---
import { Font } from "astro:assets";
import "../styles/global.css";
import Asterism from "../components/Asterism.astro";
import Panel from "../components/Panel.astro";

interface Props {
    title?: string;
    description?: string;
}

const { title = "Keaton Elvins", description } = Astro.props;
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        {description && <meta name="description" content={description} />}
        <meta property="og:title" content={title} />
        {
            description && (
                <meta property="og:description" content={description} />
            )
        }
        <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
        <meta
            name="theme-color"
            media="(prefers-color-scheme: light)"
            content="#f8f8f8"
        />
        <meta
            name="theme-color"
            media="(prefers-color-scheme: dark)"
            content="#0f0f0f"
        />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <Font cssVariable="--font-mono" preload />
        <Font cssVariable="--font-serif" />
        <Font cssVariable="--font-sans" />
        <script is:inline>
            const theme =
                new URLSearchParams(location.search).get("theme") ??
                localStorage.theme;
            if (theme) document.documentElement.dataset.theme = theme;
        </script>
    </head>
    <body>
        <button class="glyph" data-panel-open aria-label="open the index">
            <Asterism />
        </button>
        <slot />
        <Panel />
        <script>
            const videos = document.querySelectorAll("video");
            if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
                for (const v of videos) {
                    v.removeAttribute("autoplay");
                    v.pause();
                }
            } else {
                const observer = new IntersectionObserver((entries) => {
                    for (const { target, isIntersecting } of entries) {
                        const v = target as HTMLVideoElement;
                        if (isIntersecting) v.play().catch(() => {});
                        else v.pause();
                    }
                });
                for (const v of videos) observer.observe(v);
                addEventListener("pageshow", ({ persisted }) => {
                    if (!persisted) return;
                    for (const v of videos) {
                        observer.unobserve(v);
                        observer.observe(v);
                    }
                });
            }
        </script>
    </body>
</html>
