---
import type { ImageMetadata } from "astro";
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import Asterism from "./Asterism.astro";
import home from "../archive/scans/journal.avif";
import bookshelf from "../archive/bookshelf/misc.avif";

// the cutout: 4:3, served once at 2×; its css height is injected onto
// the dialog as --thumb-h. thumbs cover the frame; an entry's optional
// crop steers the vertical window (0 top … 1 bottom) when the image
// overflows it. a video entry layers its loop above its still, cued a
// beat after selection so a passing scrub stays still; the loop only
// surfaces once frames flow, and rewinds on deselect so it always
// resumes from the frame the still holds — the handoff is invisible
const THUMB_H = 480;
const THUMB_W = (THUMB_H / 3) * 4;

// serve the cover size uncropped — css places the window
const cover = async (image: ImageMetadata) => {
    const s = Math.max(
        (THUMB_W * 2) / image.width,
        (THUMB_H * 2) / image.height,
    );
    return (
        await getImage({
            src: image,
            width: Math.round(image.width * s),
            height: Math.round(image.height * s),
            format: "avif",
        })
    ).src;
};

// pages are rooms; a page's row and thumb both derive from its id
const pages: {
    id: string;
    href: string;
    image: ImageMetadata;
    crop?: number;
    video?: string;
}[] = [
    { id: "home", href: "/", image: home },
    { id: "bookshelf", href: "/bookshelf", image: bookshelf },
];

const artifacts = await getCollection("artifacts");
const thumbs = await Promise.all(
    [
        ...pages,
        ...artifacts.map(({ id, data }) => ({
            id,
            image: data.image,
            crop: data.crop,
            video: data.video,
        })),
    ].map(async ({ id, image, crop, video }) => ({
        id,
        crop,
        video,
        src: await cover(image),
    })),
);

// both groups share one row template; a row's thumb is keyed by its id
const groups = [
    {
        label: "pages",
        rows: pages.map((p) => ({
            id: p.id,
            href: p.href,
            title: p.id,
            meta: `/${p.id}`,
        })),
    },
    {
        label: "artifacts",
        rows: artifacts.map((a) => ({
            id: a.id,
            href: `/${a.id}`,
            title: a.data.title,
            meta: `${a.data.medium}, ${a.data.year}`,
        })),
    },
];
---

<dialog id="panel" aria-label="index" style={`--thumb-h: ${THUMB_H / 16}rem`}>
    <div class="frame">
        <input
            id="panel-filter"
            type="search"
            autofocus
            name="search"
            placeholder="what is it that you are looking for?"
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
            spellcheck="false"
            enterkeyhint="go"
            role="combobox"
            aria-expanded="true"
            aria-controls="panel-list"
            aria-autocomplete="list"
            aria-label="filter the index"
        />
        <div class="stage">
            <nav id="panel-list" role="listbox" aria-label="everything">
                {
                    groups.map((g) => (
                        <section>
                            <p class="group">{g.label}</p>
                            <div class="rows">
                                {g.rows.map((r) => (
                                    <a
                                        class="row"
                                        id={`panel-opt-${r.id}`}
                                        role="option"
                                        href={r.href}
                                        data-thumb={r.id}
                                    >
                                        <span>{r.title}</span>
                                        <span class="meta">{r.meta}</span>
                                    </a>
                                ))}
                            </div>
                        </section>
                    ))
                }
            </nav>
            <figure class="cutout" aria-hidden="true">
                <Asterism />
                {
                    thumbs.map((t) => (
                        <>
                            <img
                                src={t.src}
                                data-thumb-of={t.id}
                                alt=""
                                style={
                                    t.crop != null
                                        ? `--y: ${t.crop * 100}%`
                                        : undefined
                                }
                                loading="lazy"
                                decoding="async"
                                hidden
                            />
                            {t.video && (
                                <video
                                    src={t.video}
                                    data-thumb-of={t.id}
                                    style={
                                        t.crop != null
                                            ? `--y: ${t.crop * 100}%`
                                            : undefined
                                    }
                                    muted
                                    loop
                                    playsinline
                                    preload="none"
                                    hidden
                                />
                            )}
                        </>
                    ))
                }
            </figure>
        </div>
        <p class="hint">
            <span>↑↓ move · ⮠ select · ⌘+k open/close index</span>
            <button id="panel-close">close</button>
            <button id="panel-fiat">fiat nox!</button>
        </p>
    </div>
</dialog>

<style>
    #panel {
        width: min(76rem, calc(100vw - 2rem));
        max-height: min(76vh, 50rem);
        margin: auto;
        padding: 0;
        border: 0;
        background: var(--bg);
    }
    #panel::backdrop {
        background: rgb(0 0 0 / 35%);
    }

    .frame {
        display: flex;
        flex-direction: column;
        max-height: inherit;
        padding: 1rem;
    }

    #panel-filter {
        appearance: none;
        flex: none;
        width: 100%;
        padding: 0.1rem 0.1rem;
        border: 0;
        border-bottom: 1px solid var(--ink);
        background: none;
        color: inherit;
        font: inherit;
        font-size: 1.3rem;
        font-family: var(--font-sans);
        letter-spacing: -0.05em;
    }
    @media (min-width: 50rem) {
        #panel-filter {
            font-size: 3rem;
            line-height: 1.1;
        }
    }
    @media (min-width: 78rem) {
        #panel-filter {
            font-size: 5rem;
        }
    }
    #panel-filter::-webkit-search-decoration,
    #panel-filter::-webkit-search-cancel-button {
        display: none;
    }
    #panel-filter::placeholder {
        color: var(--dim);
        opacity: 1;
    }
    #panel-filter:focus {
        outline: none;
    }

    /* fixed-height so the cutout keeps its ratio and filtering doesn't
       resize the panel */
    .stage {
        display: flex;
        flex: 0 1 auto;
        height: var(--thumb-h);
        min-height: 0;
    }

    nav {
        flex: 1 1 auto;
        min-width: 0;
        overflow-y: auto;
        overscroll-behavior: contain;
        scrollbar-width: none;
    }
    nav::-webkit-scrollbar {
        display: none;
    }

    .cutout {
        display: grid;
        /* one definite cell — auto tracks size to the img's intrinsic px,
           leaving no fixed box for the cover crop to fill */
        grid-template: 100% / 100%;
        place-items: center;
        flex: none;
        height: 100%;
        aspect-ratio: 4 / 3;
        margin: 0;
        overflow: hidden;
    }
    .cutout > :global(*) {
        grid-area: 1 / 1;
    }
    .cutout > :global(svg) {
        width: 14rem;
        color: var(--ink);
    }
    .cutout:has(:is(img, video):not([hidden])) > :global(svg) {
        display: none;
    }
    .cutout :is(img, video) {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: 50% var(--y, 50%);
    }
    /* the loop rides above its still and surfaces only once frames
       flow — no poster gap can show through */
    .cutout video {
        opacity: 0;
    }
    .cutout video.rolling {
        opacity: 1;
    }
    section {
        display: grid;
        grid-template-columns: 7rem 1fr;
    }
    section + section {
        border-top: 1px solid var(--ink);
    }
    /* our display values (and global img { display: block }) outrank
       the ua [hidden] rule */
    section[hidden],
    .row[hidden],
    .cutout :is(img, video)[hidden] {
        display: none;
    }

    .group {
        /* bottom short of symmetric so a lone row, not the label,
           sets the section's floor */
        margin: 0.55rem 1rem 0.4rem;
        font-size: 0.8125rem;
        color: var(--dim);
    }

    .row {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        width: 100%;
        padding: 0.35rem 0.75rem;
        font-size: 1rem;
        letter-spacing: -0.02em;
        text-align: left;
        text-decoration: none;
    }
    .row span:first-child {
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
    }
    .row .meta {
        flex: none;
        color: var(--dim);
        font-size: 0.8125rem;
        line-height: 1.85;
    }
    .row.active {
        background: var(--ink);
        color: var(--bg);
    }
    .row.active .meta {
        color: var(--bg);
    }

    .hint {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex: none;
        margin: 0;
        /* low ascender (958/1000 vs 715 cap) so manual center */
        padding: 0.525rem 1rem 0.675rem;
        border-top: 1px solid var(--ink);
        font-size: 0.75rem;
        color: var(--dim);
    }
    #panel-close {
        display: none;
    }
    #panel-fiat {
        margin-left: auto;
    }
    #panel-fiat:hover {
        color: var(--ink);
    }

    @media (max-width: 78rem) {
        section {
            grid-template-columns: 1fr;
        }
        .group {
            display: none;
        }
    }
    @media (min-width: 50rem) and (max-width: 78rem) {
        .row .meta {
            display: none;
        }
    }

    @media (max-width: 50rem) {
        #panel {
            width: 100vw;
            height: 100vh;
            height: 100dvh;
            max-width: none;
            max-height: none;
            margin: 0;
        }
        .frame {
            height: 100%;
            max-height: none;
        }
        /* the cutout pins beneath the search; rows scrub under it, and
           the row passing its lower edge holds the selection */
        .stage {
            --cut-h: calc((100vw - 2rem) * 3 / 4);
            position: relative;
            flex: 1 1 auto;
            height: auto;
        }
        .cutout {
            position: absolute;
            inset: 0 0 auto;
            height: var(--cut-h);
            background: var(--bg);
            z-index: 1;
        }
        nav {
            /* one row of rest zone under the cutout before the first row */
            padding-top: calc(var(--cut-h) + 2.2rem);
        }
        /* runway below the list so the bottommost row can climb to the
           line and rest there; 100% is the content box, which the
           padding-top has already shortened by cutout + one row */
        nav::after {
            content: "";
            display: block;
            height: 100%;
        }
        .hint span {
            display: none;
        }
        #panel-close {
            display: block;
        }
    }
</style>

<script>
    const panel = document.getElementById("panel") as HTMLDialogElement;
    const filter = document.getElementById("panel-filter") as HTMLInputElement;
    const fiat = document.getElementById("panel-fiat") as HTMLElement;
    const rows = [...panel.querySelectorAll<HTMLElement>(".row")];
    const thumbs = [
        ...panel.querySelectorAll<HTMLImageElement | HTMLVideoElement>(
            ".cutout img, .cutout video",
        ),
    ];
    const scroller = document.getElementById("panel-list") as HTMLElement;
    const cutout = panel.querySelector(".cutout") as HTMLElement;
    const mobile = matchMedia("(max-width: 50rem)");
    const root = document.documentElement;

    const effectiveTheme = () =>
        root.dataset.theme ??
        (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
    const relabel = () => {
        fiat.textContent =
            effectiveTheme() === "dark" ? "fiat lux!" : "fiat nox!";
    };

    const open = () => {
        filter.value = "";
        apply("");
        relabel();
        panel.showModal();
        scroller.scrollTop = 0;
        // hidden lazy imgs never intersect, so stock the cutout by hand
        for (const t of thumbs)
            if (t instanceof HTMLImageElement) t.loading = "eager";
        // browsing-first on small screens: the keyboard waits for a tap
        if (mobile.matches) filter.blur();
    };

    document
        .querySelector("[data-panel-open]")
        ?.addEventListener("click", open);
    document
        .getElementById("panel-close")!
        .addEventListener("click", () => panel.close());
    addEventListener("keydown", (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key === "k") {
            e.preventDefault();
            panel.open ? panel.close() : open();
        }
    });

    panel.addEventListener("click", (e) => {
        if (e.target === panel) panel.close();
    });

    // closing must silence a playing loop; the dialog only hides it
    panel.addEventListener("close", () => select(undefined, false));

    // a page restored from the back/forward cache keeps its dom — close over it
    addEventListener("pageshow", (e) => {
        if (e.persisted && panel.open) panel.close();
    });

    const visible = () => rows.filter((r) => !r.hidden);
    // a video thumb cues after a beat — a scrub passing over its row
    // stays on the still and never fetches the loop. it surfaces only
    // once frames flow, and rewinds on deselect, so it always takes
    // over from the exact frame the still beneath it holds
    const still = matchMedia("(prefers-reduced-motion: reduce)");
    let cue: ReturnType<typeof setTimeout> | undefined;
    for (const t of thumbs)
        if (t instanceof HTMLVideoElement)
            t.addEventListener("playing", () => t.classList.add("rolling"));
    const select = (row: HTMLElement | undefined, scroll = true) => {
        for (const r of rows) {
            r.classList.toggle("active", r === row);
            r.setAttribute("aria-selected", String(r === row));
        }
        clearTimeout(cue);
        for (const t of thumbs) {
            t.hidden = t.dataset.thumbOf !== row?.dataset.thumb;
            if (!(t instanceof HTMLVideoElement)) continue;
            if (t.hidden) {
                t.pause();
                t.currentTime = 0;
                t.classList.remove("rolling");
            } else if (!still.matches)
                cue = setTimeout(() => t.play().catch(() => {}), 300);
        }
        filter.setAttribute("aria-activedescendant", row?.id ?? "");
        if (scroll) row?.scrollIntoView({ block: "nearest" });
    };

    function apply(q: string) {
        for (const row of rows)
            row.hidden = !row.textContent!.toLowerCase().includes(q);
        for (const section of panel.querySelectorAll("section"))
            section.hidden = !section.querySelector(".row:not([hidden])");
        select(q ? visible()[0] : undefined);
    }

    filter.addEventListener("input", () => {
        // re-anchor: a stale scroll would immediately re-pick by line
        scroller.scrollTop = 0;
        apply(filter.value.trim().toLowerCase());
    });

    panel.addEventListener("keydown", (e) => {
        // by hand: the search input swallows esc (clearing itself) before
        // the dialog's native cancel can see it
        if (e.key === "Escape") {
            e.preventDefault();
            panel.close();
            return;
        }
        if (e.key !== "ArrowDown" && e.key !== "ArrowUp" && e.key !== "Enter")
            return;
        const list = visible();
        const at = list.findIndex((r) => r.classList.contains("active"));
        if (e.key === "Enter") {
            if (at >= 0 && document.activeElement === filter) {
                e.preventDefault();
                list[at].click();
            }
            return;
        }
        e.preventDefault();
        const next =
            e.key === "ArrowDown"
                ? Math.min(at + 1, list.length - 1)
                : Math.max(at - 1, 0);
        select(list[next]);
    });

    // hover reads pointermove, not pointerenter: key-scrolling slides
    // rows under a resting cursor, firing enter (and synthetic moves) at
    // unchanged coordinates — only real travel may select
    let px = 0;
    let py = 0;
    scroller.addEventListener("pointermove", (e) => {
        if (e.pointerType !== "mouse") return;
        if (e.clientX === px && e.clientY === py) return;
        px = e.clientX;
        py = e.clientY;
        const row = (e.target as Element).closest<HTMLElement>(".row");
        if (row && !row.classList.contains("active")) select(row, false);
    });
    // navigating within the page (e.g. /#artifact) must still close the panel
    scroller.addEventListener("click", (e) => {
        if ((e.target as Element).closest("a.row")) panel.close();
    });

    // mobile scrub: the row passing beneath the cutout holds the selection;
    // resting at the top hands it back to the asterism (or the first match
    // while a query is live, echoing apply)
    scroller.addEventListener(
        "scroll",
        () => {
            if (!mobile.matches) return;
            const seek = visible();
            const rowH = seek[0]?.offsetHeight ?? 0;
            // the rest zone runs one row deep — matching the padding
            // above the first row — before the montage engages
            if (scroller.scrollTop < Math.max(rowH, 4)) {
                select(filter.value.trim() ? seek[0] : undefined, false);
                return;
            }
            // half a row down: the pick hands off mid-vanish instead of
            // clinging to a row until it's fully swallowed
            const line = cutout.getBoundingClientRect().bottom + rowH / 2;
            select(
                seek.find((r) => r.getBoundingClientRect().bottom > line),
                false,
            );
        },
        { passive: true },
    );

    fiat.addEventListener("click", () => {
        const next = effectiveTheme() === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        localStorage.theme = next;
        relabel();
    });

    if (new URLSearchParams(location.search).has("panel")) open();
</script>
