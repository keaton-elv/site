---
import { getCollection, getEntry } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Loop from "../components/Loop.astro";

// sizing rules: AGENTS.md → images & video. the bed's geometry lives here
const COLUMNS = 16;
const BED = 1600; // .scanner-bed max-width, 100rem

const slot = (w: number) => `calc(min(100vw, ${BED}px) / ${COLUMNS} * ${w})`;
const poster = (w: number) => Math.round((BED / COLUMNS) * w * 2);

// each placement in home.yaml points at an entry in the index
const artifacts = await Promise.all(
    (await getCollection("home"))
        .sort((a, b) => a.data.at - b.data.at)
        .map(async ({ id, data: place }) => {
            const artifact = await getEntry("artifacts", id);
            if (!artifact)
                throw new Error(`home.yaml: "${id}" is not in the index`);
            return { id, place, data: artifact.data };
        }),
);
---

<Layout>
    <main class="scanner-bed">
        {
            artifacts.map(({ id, data: a, place }, i) => (
                <figure
                    class="artifact"
                    style={`--w: ${place.w}; --x: ${place.x}; --mt: ${place.mt}`}
                >
                    <a href={`/${id}`}>
                        {a.video ? (
                            <Loop
                                src={a.video}
                                still={a.image}
                                width={poster(place.w)}
                            />
                        ) : (
                            <Image
                                src={a.image}
                                alt={a.alt ?? ""}
                                sizes={`(max-width: 45rem) 100vw, ${slot(place.w)}`}
                                format="avif"
                                loading={i === 0 ? "eager" : undefined}
                                fetchpriority={i === 0 ? "high" : undefined}
                            />
                        )}
                    </a>
                </figure>
            ))
        }
    </main>
</Layout>

<style>
    .scanner-bed {
        display: grid;
        grid-template-columns: repeat(16, 1fr);
        gap: 0;
        max-width: 100rem;
        padding: 2rem 0rem 8rem;
    }

    .artifact {
        grid-column: var(--x) / span var(--w);
        margin: calc(var(--mt) * 1rem) 0 0;
    }

    .artifact video {
        width: 100%;
    }

    .artifact > a {
        display: block;
    }

    @media (max-width: 45rem) {
        .scanner-bed {
            display: block;
            padding: 4rem 0 8rem;
        }
        .artifact {
            margin: 1rem 0 0;
        }
        .artifact:first-child {
            margin-top: 0;
        }
    }
</style>
