---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Essay from "../layouts/Essay.astro";
import Vitrine from "../layouts/Vitrine.astro";

// Every artifact lives at /<id>; its medium decides the display.
export async function getStaticPaths() {
    const artifacts = await getCollection("artifacts");
    return artifacts.map((entry, i) => ({
        params: { slug: entry.id },
        props: {
            artifact: entry,
            prev: `/${artifacts.at(i - 1)!.id}`,
            next: `/${artifacts[(i + 1) % artifacts.length].id}`,
        },
    }));
}

interface Props {
    artifact: CollectionEntry<"artifacts">;
    prev: string;
    next: string;
}

const { artifact, prev, next } = Astro.props;
const Content =
    artifact.data.medium === "writing" && (await render(artifact)).Content;
---

{
    Content ? (
        <Essay entry={artifact} prev={prev} next={next}>
            <Content />
        </Essay>
    ) : (
        <Vitrine entry={artifact} prev={prev} next={next} />
    )
}
