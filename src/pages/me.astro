---
import Layout from "../layouts/Layout.astro";

const likes = [
    {
        term: "Å",
        note: "is the little village at the very end of the road on the Lofoten archipelago",
    },
    {
        term: "Blackberry Jam",
        note: "is a food product made from blackberries, water, and sugar. It is good on skyr or toast",
    },
    {
        term: "Clay",
        note: "is a type of fine-grained soil. It is cold in the bag and warm in the hand and also the first known writing medium (clay tablets)",
    },
    {
        term: "Dancing",
        note: "is an art form consisting of sequences of body movements with aesthetic or symbolic value, such as the Pirouette or the Worm",
    },
    {
        term: "Fatsia japonica",
        note: "is a species of plant in the family Araliaceae, native to southern Japan and Korea. I have one on my desk",
    },
    {
        term: "Fennel",
        note: "is a flowering plant species in the carrot family. The dried seeds taste similar to anise and are wonderful to have in sausage or your pockets",
    },
    {
        term: "Gnocchi alla Sorrentina",
        note: "is a classic dish from Sorrento. The frozen TJ’s version uses pregelatinized gnocchi made in Lazio. They are like little rubber balls",
    },
    {
        term: "Grids",
        note: "are tessellations of n-dimensional Euclidean space by congruent parallelotopes",
    },
    {
        term: "Hum",
        note: "is a poem by Mary Oliver from <i>New and Selected Poems: Volume Two</i>. It's also a sound produced by closed lips or insects or other periodic motion",
    },
    {
        term: "Le Petit Prince",
        note: "is a novella about a little prince. The proof that he existed is that he was charming, that he laughed, and that he was looking for a sheep.",
    },
    {
        term: "Mason Jars",
        note: "are glass jars used to preserve food. They are named after American tinsmith John Landis Mason and often found in boxes on the sidewalk",
    },
    {
        term: "North",
        note: "is one of the four cardinal directions. It is the diametric opposite of south and perpendicular to east and west",
    },
    {
        term: "Outline (trilogy)",
        note: "is a series of novels by Rachel Cusk, who is probably god",
    },
    {
        term: "Peter Mendelsund",
        note: "is an author, painter, and graphic designer. He wrote <i>The Look of the Book</i>, which is cherished and stands above my fatsia",
    },
    {
        term: "Questions",
        note: "are utterances which serve as a request for information, distinguished from interrogatives (the grammatical forms typically used to express them)",
    },
    {
        term: "Raising Arizona",
        note: "is a 1987 American crime comedy film written, directed, and produced by Joel and Ethan Coen",
    },
    {
        term: "Richard Diebenkorn",
        note: "was a painter associated with the Bay Area Figurative Movement. He had an artistic epiphany the first time he looked out an airplane window",
    },
    {
        term: "Sun",
        note: "is a massive sphere of hot plasma, heated to incandescence by nuclear fusion. It’s also a tarot card that depicts a naked child riding a white horse",
    },
    {
        term: "Tap Water",
        note: "is water supplied through a tap. It tastes pretty good in San Francisco, at least compared to other places",
    },
    {
        term: "Ursula K. Le Guin",
        note: "was a writer of novels and poetry and literary criticism and translations and children's books. The K stands for Kroeber",
    },
    {
        term: "Vermilion",
        note: "is a brilliant orange-red color. The term comes from Old French <i>vermeillon</i>, derived from <i>vermeil</i>, from Latin <i>vermiculus</i> – the diminutive of <i>vermis</i> or ‘worm’",
    },
    {
        term: "Wim Wenders",
        note: "is a German filmmaker that won the Palme d'Or for his film <i>Paris, Texas</i> (1984). The town features a 20m tall Eiffel Tower adorned by a red cowboy hat",
    },
    {
        term: "Zürau Aphorism #29",
        note: "is one of 109 aphorisms of Franz Kafka, written while suffering from tuberculosis. He described this period as perhaps the best in his life",
    },
];
---

<Layout title="me" description="a few things you ought to know" sans={[500]}>
    <main class="me">
        <div class="bio">
            <p>
                Keaton is a <s>writer</s> designer and researcher based in San Francisco
            </p>
            <p>
                He likes to read and splash around in the bay and get all
                shivery
            </p>
            <p class="write">
                Say hi at <button
                    class="email"
                    type="button"
                    title="copy to clipboard"
                    aria-live="polite"></button>
            </p>
        </div>
        <p class="likes">
            {
                likes.map(({ term, note }) => (
                    <span class="like">
                        {`${term}. `}
                        {note && (
                            <span class="note">
                                <i>{term}</i> <Fragment set:html={note} />
                            </span>
                        )}
                    </span>
                ))
            }
        </p>
    </main>
</Layout>

<style>
    .me {
        --pad: 2.5rem;
        position: relative;
        display: flex;
        flex-direction: column;
        row-gap: 3rem;
        min-height: 100vh;
        min-height: 100svh;
        padding: 4rem var(--pad) 5rem;
    }

    .bio {
        max-width: 36rem;
        font-family: var(--font-sans);
        font-size: 1.125rem;
        line-height: 1;
    }

    .bio p {
        margin: 0 0 1em;
    }

    .likes {
        font-size: clamp(1.9rem, 4.6vw, 4.25rem);
        margin-block: auto;
        font-family: var(--font-sans);
        font-weight: 500;
        line-height: 1.2;
        text-align: justify;
    }

    .like:hover {
        background: var(--ink);
        color: var(--bg);
    }

    .note {
        display: none;
    }
    .like:hover .note {
        display: block;
        position: absolute;
        inset-inline: var(--pad);
        bottom: 2rem;
        font: 400 0.875rem/1.5 var(--font-mono);
        color: var(--ink);
        text-align: left;
    }

    .email {
        font-family: var(--font-mono);
        font-size: 1rem;
        color: var(--dim);
        transition: color 120ms ease;
    }
    .email:hover {
        color: var(--ink);
    }
    .email.copied {
        transition: none;
        background: var(--ink);
        color: var(--bg);
    }

    @media (max-width: 45rem) {
        .me {
            --pad: 1rem;
            padding-top: 4rem;
            row-gap: 2rem;
        }
        .likes {
            margin-block: 0 auto;
        }
        .bio {
            font-size: 1rem;
        }
        .bio p {
            margin: 0 0 0.8em;
        }
        .like:hover .note {
            font-size: 0.75rem;
            line-height: 1.35;
            bottom: 1rem;
        }
    }
</style>

<script>
    // assembled here so the address never appears in the built html
    document.addEventListener("astro:page-load", () => {
        const email = document.querySelector<HTMLButtonElement>(".email");
        if (!email) return;
        const addr = ["keatonelvins", "gmail.com"].join("@");
        email.textContent = addr;
        email.style.minWidth = `${addr.length}ch`;
        let hold: ReturnType<typeof setTimeout>;
        email.addEventListener("click", () => {
            navigator.clipboard.writeText(addr).then(() => {
                email.classList.add("copied");
                email.textContent = "copied! :D";
                clearTimeout(hold);
                hold = setTimeout(() => {
                    email.classList.remove("copied");
                    email.textContent = addr;
                }, 1200);
            });
        });
    });
</script>
