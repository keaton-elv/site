---
import Layout from "../layouts/Layout.astro";

const likes = [
    {
        term: "Å",
        note: "is the little village at the end of the Lofoten archipelago's single serpentine highway",
    },
    {
        term: "Blackberry Jam",
        note: "is a food product made from blackberries, water, and sugar. It is good on skyr or toast",
    },
    {
        term: "Cate Le Bon",
        note: "is experimental and Welsh. She is a singer and songwriter and record producer. Her music sounds like daylight or jasmine in your pocket",
    },
    {
        term: "Dark Chocolate",
        note: "is a form of chocolate containing cocoa solids and cocoa butter without added milk. I like to have a little nibble every day",
    },
    {
        term: "Envelopes",
        note: "are paper containers, in both senses",
    },
    {
        term: "Fennel",
        note: "is a flowering plant species in the carrot family. The dried seeds taste similar to anise and are wonderful in sausage",
    },
    {
        term: "Grids",
        note: "are tessellations of n-dimensional Euclidean space by congruent parallelotopes. Popular grids include the Quaternary Triangular Mesh and hopscotch",
    },
    {
        term: "Hum",
        note: "is a poem by Mary Oliver from <i>New and Selected Poems: Volume Two</i>. It's also a sound produced by closed lips or assiduous insects or other periodic motions",
    },
    {
        term: "Isosemes",
        note: "are geographic boundaries used to demarcate differences in a particular word's meaning across a region",
    },
    {
        term: "Jumping Onto Things",
        note: "is a physical action involving a leap from one surface to another (typically elevated) such surface",
    },
    {
        term: "Keys",
        note: "are pointy and easily misplaced. Sometimes people have a little golden one in their navel that can be used to wind them up",
    },
    {
        term: "Le Petit Prince",
        note: "is a novella about a little prince. The proof that he existed is that he was charming, that he laughed, and that he was looking for a sheep",
    },
    {
        term: "Mason Jars",
        note: "are glass jars used to preserve food. They are named after American tinsmith John Landis Mason and grow in cardboard boxes by the curb",
    },
    {
        term: "Negative Space",
        note: "",
    },
    {
        term: "Outline (trilogy)",
        note: "is a series of novels by Rachel Cusk, who is probably god",
    },
    {
        term: "Peter Mendelsund",
        note: "is an author, painter, and graphic designer. He wrote <i>The Look of the Book</i>, which I cherish and have displayed above my desk",
    },
    {
        term: "Questions",
        note: "are utterances which serve as a request for information, distinguished from interrogatives (the grammatical forms typically used to express them)",
    },
    {
        term: "Richard Diebenkorn",
        note: "was a painter associated with the Bay Area Figurative Movement. He had an artistic epiphany the first time he looked out an airplane window",
    },
    {
        term: "Syzygy",
        note: "is the alignment of three celestial bodies in a gravitational system, such as an eclipse or transit, and a great hangman word if you are annoying",
    },
    {
        term: "Tap Water",
        note: "is water supplied through a tap. It tastes pretty good in San Francisco, at least compared to other places",
    },
    {
        term: "Ursula K. Le Guin",
        note: "was a writer of novels and poetry and literary criticism and translations and children's books. The K stands for Kroeber",
    },
    {
        term: "Vermilion",
        note: "is a brilliant orange-red color. The term comes from Old French <i>vermeillon</i>, derived from <i>vermeil</i>, from Latin <i>vermiculus</i> – the diminutive of <i>vermis</i> or ‘worm’.",
    },
    {
        term: "Wim Wenders",
        note: "is a German filmmaker that won the Palme d'Or for his film <i>Paris, Texas</i>, a real-life town with its own Eiffel Tower adorned by a little red hat",
    },
    {
        term: "X-Acto Knives",
        note: "are very sharp and the preferred implement of ransom note enthusiasts everywhere",
    },
    {
        term: "Ylem",
        note: "is the hypothetical primordial soup from before atoms decoupled and released the cosmic microwave background",
    },
    {
        term: "Zürau Aphorism #29",
        note: "is one of 109 aphorisms written by Franz Kafka while suffering from tuberculosis on a farm. He described this period as perhaps the best in his life",
    },
];
---

<Layout title="me" description="a few things you ought to know" sans={[500]}>
    <main class="me">
        <div class="bio">
            <p>
                Keaton is a <s>writer</s> designer and researcher based in San Francisco
            </p>
            <p>
                He likes to read and splash around in the bay and get all
                shivery
            </p>
            <p class="write">
                Say hi at <button
                    class="email"
                    type="button"
                    title="copy to clipboard"
                    aria-live="polite"></button>
            </p>
        </div>
        <p class="likes">
            {
                likes.map(({ term, note }) => (
                    <span class="like">
                        {`${term}. `}
                        {note && (
                            <span class="note">
                                <i>{term}</i> <Fragment set:html={note} />
                            </span>
                        )}
                    </span>
                ))
            }
        </p>
    </main>
</Layout>

<style>
    .me {
        --pad: 2.5rem;
        position: relative;
        display: flex;
        flex-direction: column;
        row-gap: 3rem;
        min-height: 100vh;
        min-height: 100svh;
        padding: 4rem var(--pad) 5rem;
    }

    .bio {
        max-width: 36rem;
        font-family: var(--font-sans);
        font-size: 1.125rem;
        line-height: 1;
    }

    .bio p {
        margin: 0 0 1em;
    }

    .likes {
        font-size: clamp(1.9rem, 4.6vw, 4rem);
        margin-block: auto;
        font-family: var(--font-sans);
        font-weight: 500;
        line-height: 1.2;
        text-align: justify;
    }

    .like:hover {
        background: var(--ink);
        color: var(--bg);
    }

    .note {
        display: none;
    }
    .like:hover .note {
        display: block;
        position: absolute;
        inset-inline: var(--pad);
        bottom: 2rem;
        font: 400 0.875rem/1.5 var(--font-mono);
        color: var(--ink);
        text-align: left;
    }

    .email {
        font-family: var(--font-mono);
        font-size: 1rem;
        color: var(--dim);
        transition: color 120ms ease;
    }
    .email:hover {
        color: var(--ink);
    }
    .email.copied {
        transition: none;
        background: var(--ink);
        color: var(--bg);
    }

    @media (max-width: 45rem) {
        .me {
            --pad: 1rem;
            padding-top: 1.75rem;
            row-gap: 1.5rem;
        }
        .likes {
            margin-block: auto;
            font-size: clamp(1.8rem, 4.6vw, 4.25rem);
            line-height: 1.2;
        }
        .bio {
            max-width: calc(100% - 3.75rem);
            font-size: 0.9375rem;
        }
        .bio p {
            margin: 0 0 0.8em;
        }
        .like:hover .note {
            font-size: 0.75rem;
            line-height: 1.35;
            bottom: 1rem;
        }
    }
</style>

<script>
    // assembled here so the address never appears in the built html
    document.addEventListener("astro:page-load", () => {
        const email = document.querySelector<HTMLButtonElement>(".email");
        if (!email) return;
        const addr = ["keatonelvins", "gmail.com"].join("@");
        email.textContent = addr;
        email.style.minWidth = `${addr.length}ch`;
        let hold: ReturnType<typeof setTimeout>;
        email.addEventListener("click", () => {
            navigator.clipboard.writeText(addr).then(() => {
                email.classList.add("copied");
                email.textContent = "copied! :D";
                clearTimeout(hold);
                hold = setTimeout(() => {
                    email.classList.remove("copied");
                    email.textContent = addr;
                }, 1200);
            });
        });
    });
</script>
